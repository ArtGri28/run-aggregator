# Реальные значения — только в .env вне репозитория (права 600), MVP.md §12.1.
# Строка подключения PostgreSQL в формате URL libpq; её читают migrate, healthcheck, bot, worker.
# Dev-БД (docker-compose.dev.yml) — без пароля в URL, пароль берётся из PGPASSWORD:
#   postgres://aggregator@127.0.0.1:5434/aggregator_dev?sslmode=disable
DATABASE_URL=

# Только для интеграционных тестов, БД из docker-compose.test.yml (без пароля).
TEST_DATABASE_URL=postgres://aggregator@127.0.0.1:5433/aggregator_test?sslmode=disable

# Контакт владельца: уходит сайтам в User-Agent, в логи и файлы не пишется.
# Обязателен для `worker` и `worker run-once`.
OWNER_CONTACT=

# Пароль dev-БД: docker compose читает его из .env.
DEV_POSTGRES_PASSWORD=
# Тот же пароль для подключения: pgx берёт его из окружения, поэтому в URL его нет.
PGPASSWORD=

# Каталог сырых ответов (по умолчанию data/raw).
RAW_DIR=
# Формат логов: json (по умолчанию) или text — для чтения глазами.
LOG_FORMAT=

# Production на VPS (/opt/aggregator/.env, права 600, создаёт deploy/vps/deploy-apply.sh).
# Токен бота из BotFather: получает только сервис bot.
TELEGRAM_BOT_TOKEN=
# Числовые Telegram ID администраторов через запятую: /runs, принятие прогона, алерты.
ADMIN_TG_IDS=
# Пароль PostgreSQL production: действует при первой инициализации тома; compose сам
# передаёт его сервисам как PGPASSWORD (PGPASSWORD выше — только для dev/локального запуска).
POSTGRES_PASSWORD=
# Тег образа aggregator:<IMAGE_TAG> (обычно короткий хеш коммита); ставит deploy-apply.sh.
IMAGE_TAG=

# Необязательные параметры (значения по умолчанию — в коде):
# INGEST_INTERVAL=6h  INGEST_JITTER=30m  INGEST_RUN_TIMEOUT=30m  RAW_TTL=336h
# OBSERVE_GONE_RUNS=3  OBSERVE_GONE_AFTER=72h
# QUALITY_MIN_RUNS=3  QUALITY_LOW_RATIO=0.5  QUALITY_HIGH_RATIO=5
# QUALITY_REJECTED_MAX=0.20  QUALITY_REJECTED_ABS=0.30  QUALITY_DATE_OOR_MAX=0.05
# QUALITY_OUT_OF_SCOPE_MAX=0.20  QUALITY_UNRECOGNIZED_MAX=0.10  QUALITY_EMPTY_GROWTH=0.20
# FETCH_TIMEOUT=30s  FETCH_CONNECT_TIMEOUT=10s  FETCH_MAX_BYTES=10485760  FETCH_ATTEMPTS=3
# FETCH_BACKOFF_BASE=2s  FETCH_BACKOFF_MAX=30s  FETCH_MAX_RETRY_WAIT=2m  FETCH_HOST_MIN_INTERVAL=1s

# Дедупликация (Phase 5), необязательные; по умолчанию — значения из кода; на VPS — строкой
# в /opt/aggregator/.env (root, 600) и agg deploy; автослияние — только после калибровки
# (internal/dedup/testdata/README.md).
# DEDUP_HIGH=0.7  DEDUP_LOW=0.3  DEDUP_AUTO_MERGE=false  DEDUP_LINK_BONUS=0.10
# DEDUP_MAX_PER_EVENT=3  DEDUP_DISTANCE_TOL_M=100  DEDUP_SOURCE_PRIORITY=marathonec,probeg  DEDUP_DIGEST_AT=10:00
