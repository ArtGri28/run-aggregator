# Секреты и локальное окружение
.env
.env.*
!.env.example

# Служебный снимок состояния GSD (генерируется автоматически, меняется на каждом шаге)
.planning/state.json
# Блокировка сессии GSD (pid, id сессии) и автоматически собранные сведения о коде
.planning/milestone.lock
.planning/intel/

# Файлы macOS и IDE
.DS_Store
.idea/

# Локальные результаты аудита VPS и проб источников (могут содержать чувствительные данные)
run-agg-phase1/
.planning/phases/**/*_out.txt

# Сырые ответы источников и локальные данные worker (ING-10)
/data/
